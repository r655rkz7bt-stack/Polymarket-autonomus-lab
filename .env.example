# Copie ce fichier en .env pour un usage local. Ne committe JAMAIS .env.
# En production, ces valeurs vivent uniquement dans l'environnement GitHub "production".

# Clé HMAC du journal comptable (au moins 32 caractères aléatoires).
LEDGER_KEY=

# Code de réinitialisation du capital, connu du seul Etienne.
RESET_CODE=

# Optionnel (étape 5) : clé Google AI Studio.
GEMINI_API_KEY=
